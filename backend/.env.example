# LearnLens backend environment. Copy to backend/.env and fill in real values.

# --- MongoDB (required) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=learnlens

# --- Auth / sessions ---
AUTH_COOKIE_NAME=learnlens_session
# auto | true | false — "auto" infers HTTPS from the request / X-Forwarded-Proto
COOKIE_SECURE=auto
COOKIE_SAMESITE=lax

# --- CORS: comma-separated allowed frontend origins (never "*" with credentials) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Seed / demo credentials (required — used by startup seeding and tests) ---
DEMO_STUDENT_EMAIL=student@learnlens.demo
DEMO_STUDENT_PASSWORD=LearnLens#Student1
DEMO_TEACHER_EMAIL=teacher@learnlens.demo
DEMO_TEACHER_PASSWORD=LearnLens#Teacher1

# --- Teacher self-registration verification code (required for teacher signup) ---
TEACHER_VERIFICATION_CODE=LearnLens#Teacher1

# --- Admin email verification (optional; admin login is disabled without these) ---
ADMIN_EMAIL=admin@example.com
RESEND_API_KEY=
EMAIL_FROM=

# --- Mongo driver / startup timeouts (optional, milliseconds / seconds) ---
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=20000
SEED_TIMEOUT_SECONDS=30
